#!/bin/sh
# Abgenommener Stand = main. Nach jedem Merge/Pull auf main Test-Arbeitsplan\ neu erzeugen,
# damit Testpaket fuer die Firma und Demo nie hinter dem Quellcode zurueckliegen.
[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || exit 0
cd "$(git rev-parse --show-toplevel)" || exit 0
if cmd //c "scripts\\test-arbeitsplan.cmd" >/dev/null 2>&1; then
  echo "Test-Arbeitsplan neu erzeugt ($(git log -1 --format=%h))."
else
  echo "Test-Arbeitsplan NICHT erneuert: scripts\\test-arbeitsplan.cmd von Hand starten und Meldung pruefen." >&2
fi
exit 0
